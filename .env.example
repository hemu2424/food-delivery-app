# Backend (set these on the API host)
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
# Production example: https://your-app.vercel.app,https://your-app-git-main-your-team.vercel.app
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Frontend (set this in Vercel and redeploy after changing it)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email provider
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=your-email@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
