# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (Set on Render / Local .env)
# =============================================================================
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key

# Redis (Upstash or local)
REDIS_URL=rediss://default:<password>@<host>:6379

# Allowed CORS Origins (Comma-separated)
# For Local / Docker: http://localhost:3000,http://localhost:3001,http://localhost:3002
# For Production (Render): https://your-frontend.vercel.app
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Email Providers (Brevo / SMTP / Gmail)
EMAIL_FROM=your-email@example.com
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
Email_to=admin-notification@example.com

# Brevo API Key (Optional, recommended for Render/Vercel)
BREVO_API_KEY=

# SMTP Server (e.g., Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (Image and Video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Maps & Geocoding
GOOGLE_MAPS_API_KEY=
MAPTILER_API_KEY=

# Razorpay Payments & Webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Set on Vercel / Local .env)
# =============================================================================
# For Local: http://localhost:5000/api
# For Vercel Production: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
